<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oc_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include layout="@layout/page_home" />
            <include layout="@layout/page_movimenti" />
            <include layout="@layout/page_lista" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/barraNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/oc_surface"
            android:elevation="8dp"
            android:minHeight="56dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/oc_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="top|center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="48dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgLogoLock"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="OrbitaCasa"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="OrbitaCasa"
                android:textAppearance="?attr/textAppearanceHeadlineMedium" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="App bloccata"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSblocca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Sblocca" />

        <TextView
            android:id="@+id/txtUltimoAccesso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>
</FrameLayout>
